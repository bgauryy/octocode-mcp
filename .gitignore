node_modules
# Stale test temp dirs — tests must use os.tmpdir(), not package dir
.tmp-*
build
# Cargo build-script modules (`build.rs` includes them by #[path]); source, not output.
!packages/octocode-native/crates/runtime/build/
dist
**/.octocode-build.lock
.yarn/install-state.gz
_docs
_scripts
campaigns
# DXT files (distribute via GitHub releases)
*.dxt
# npm pack output
*.tgz
# packages/octocode-benchmark/local/e2e: the harness, fixtures and validation reports are tracked;
# cloned repos and regenerable or raw run output are not.
packages/octocode-benchmark/local/repos/*
!packages/octocode-benchmark/local/repos/README.md
packages/octocode-benchmark/local/e2e/seeded/
packages/octocode-benchmark/local/e2e/bigfiles/
packages/octocode-benchmark/local/e2e/fixtures/large/
packages/octocode-benchmark/local/e2e/fixtures/scratch/
packages/octocode-benchmark/local/e2e/fixtures/rating-*/
packages/octocode-benchmark/local/e2e/results/
packages/octocode-benchmark/local/e2e/.octocode/
packages/octocode-benchmark/local/e2e/validate/*/raw/
packages/octocode-benchmark/local/e2e/validate/*/out/
packages/octocode-benchmark/local/e2e/validate/*/probes/
packages/octocode-benchmark/local/e2e/validate/*/tools/
packages/octocode-benchmark/local/e2e/validate/*/bin/
packages/octocode-benchmark/local/e2e/validate/local/fixtures/
packages/octocode-benchmark/local/e2e/validate/github/runs.jsonl
packages/octocode-benchmark/local/e2e/validate/github/results.json
# Package READMEs are authored source and must remain trackable.
!packages/*/README.md
!packages/*/npm/*/README.md

# ─── Rust / NAPI packages ───────────────────────────────────────────────────
# Cargo build artefacts
target/
.octocode-*-target/
# Compiled NAPI native bindings — built locally per platform, never committed
*.node
# Compiled native CLI binaries in platform packages — built per platform at
# publish time, never committed (mirrors the *.node policy above).
packages/*/npm/*/octocode
packages/*/npm/*/octocode.exe
# cargo-mutants run output (current and previous run)
mutants.out/
mutants.out.old/
# Benchmark results (local timing data, machine-specific)
**/bench/results/
out
coverage
.vitest/
.octocode
.codex
.env
.cursor
.context
# Exception for committed skill bundle
!/skills/octocode-research/output/
# Canonical Agent Skills live here; generated scripts have targeted ignores above.
/skills/octocode-agent-communication/
/skills/octocode-reflection/
# Bundled skills copied into the octocode CLI package during build/prepack.
/packages/octocode/skills/
# sqlite DB
mcp.sqlite

context
.claude
.pi
AUDIT.md

# Development/benchmark artifacts
autoresearch.*

devScripts

.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
output
__pycache__
releases/**
tmp