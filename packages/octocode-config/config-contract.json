{
  "$schema": "./config-contract.schema.json",
  "config": {
    "fileName": ".octocoderc",
    "schemaVersion": 1,
    "runtimeSurfaces": [
      "mcp",
      "cli"
    ]
  },
  "environment": {
    "PATH": {
      "dotenv": "never",
      "description": "Executable search path"
    },
    "HOME": {
      "dotenv": "never",
      "description": "Operating-system home"
    },
    "SHELL": {
      "dotenv": "never",
      "description": "Login shell"
    },
    "USER": {
      "dotenv": "never",
      "description": "Operating-system user"
    },
    "LOGNAME": {
      "dotenv": "never",
      "description": "Operating-system login"
    },
    "PWD": {
      "dotenv": "never",
      "description": "Process working directory"
    },
    "TMPDIR": {
      "dotenv": "never",
      "description": "Temporary directory"
    },
    "NODE_OPTIONS": {
      "dotenv": "never",
      "description": "Node process options"
    },
    "PYTHON": {
      "dotenv": "never",
      "description": "Python executable override"
    },
    "GH_TOKEN": {
      "dotenv": "all",
      "tokenPriority": 0,
      "description": "GitHub CLI token"
    },
    "GITHUB_TOKEN": {
      "dotenv": "all",
      "tokenPriority": 1,
      "description": "GitHub Actions token"
    },
    "OCTOCODE_GITHUB_CLIENT_ID": {
      "dotenv": "home",
      "configSource": true,
      "description": "GitHub OAuth client override"
    },
    "OCTOCODE_HOME": {
      "documentation": true,
      "dotenv": "never",
      "description": "Overrides the Octocode configuration directory (default: <os-home>/.octocode)"
    },
    "OCTOCODE_AST_REWRITE_STATE_DIR": {
      "documentation": true,
      "dotenv": "home",
      "description": "Override the astRewrite transaction/recovery state directory."
    },
    "OCTOCODE_CARGO": {
      "documentation": true,
      "dotenv": "home",
      "description": "Override the cargo executable used for Rust dependency-graph analysis."
    }
  },
  "removed": {
    "settings": {
      "version": "The configuration file no longer declares a schema version; delete the key.",
      "classification.type": "The classification provider is built in; delete the key."
    },
    "environment": {
      "OCTOCODE_CLASSIFICATION_TYPE": "The classification provider is built in; unset the variable."
    }
  },
  "sections": {
    "": {
      "title": "Configuration",
      "file": true,
      "resolved": true,
      "fields": {}
    },
    "github": {
      "title": "GitHub API",
      "typeName": "GitHub",
      "file": true,
      "resolved": true,
      "fields": {
        "apiUrl": {
          "type": "url",
          "default": "https://api.github.com",
          "description": "GitHub REST API root. GitHub Enterprise commonly uses /api/v3.",
          "env": {
            "name": "GITHUB_API_URL",
            "dotenv": "home",
            "normalize": "trim"
          }
        },
        "graphqlEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Use GitHub GraphQL where supported; false forces REST-only access.",
          "env": {
            "name": "OCTOCODE_GITHUB_GRAPHQL"
          }
        }
      }
    },
    "local": {
      "title": "Local tools",
      "file": true,
      "resolved": true,
      "fields": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local filesystem tools on every runtime surface.",
          "env": {
            "name": "OCTOCODE_ENABLE_LOCAL",
            "dotenv": "home",
            "workspaceNarrowsTo": "false"
          }
        },
        "beta": {
          "type": "boolean",
          "default": false,
          "description": "Enable beta features and tools; off by default on every surface. `octocode schema` reports which tools the gate withholds.",
          "env": {
            "name": "OCTOCODE_BETA",
            "dotenv": "home"
          }
        },
        "allowedPaths": {
          "type": "stringArray",
          "default": [],
          "itemFormat": "path",
          "description": "Extra absolute or home-relative roots added to the allowed roots (workspace root and OCTOCODE_HOME).",
          "env": {
            "name": "ALLOWED_PATHS",
            "dotenv": "home"
          },
          "notes": "The environment value is a comma-separated list."
        },
        "workspaceRoot": {
          "type": "path",
          "default": null,
          "displayDefault": "process.cwd()",
          "description": "Optional absolute or home-relative workspace root.",
          "env": {
            "name": "WORKSPACE_ROOT",
            "dotenv": "home",
            "normalize": "trim"
          }
        }
      }
    },
    "tools": {
      "title": "Tool availability",
      "file": true,
      "resolved": true,
      "fields": {
        "enabled": {
          "type": "stringArray",
          "default": null,
          "description": "Strict tool allowlist replacing the default tool set.",
          "env": {
            "name": "TOOLS_TO_RUN"
          }
        },
        "disabled": {
          "type": "stringArray",
          "default": null,
          "description": "Tools removed from the default tool set.",
          "env": {
            "name": "DISABLE_TOOLS"
          }
        }
      }
    },
    "mcp": {
      "title": "MCP presentation",
      "file": true,
      "resolved": true,
      "fields": {
        "deferred": {
          "type": "stringArray",
          "default": null,
          "description": "Available tools left out of tools/list; one run({tool, query}) tool executes them and next/hints leads that name them.",
          "env": {
            "name": "OCTOCODE_DEFER_TOOLS"
          }
        }
      }
    },
    "network": {
      "title": "Network",
      "file": true,
      "resolved": true,
      "fields": {
        "timeout": {
          "type": "number",
          "minimum": 5000,
          "span": 295000,
          "defaultOffset": 25000,
          "description": "Request timeout in milliseconds.",
          "env": {
            "name": "REQUEST_TIMEOUT"
          }
        },
        "maxRetries": {
          "type": "number",
          "minimum": 0,
          "span": 10,
          "defaultOffset": 3,
          "description": "Maximum retries after a failed request.",
          "env": {
            "name": "MAX_RETRIES"
          }
        },
        "maxRateLimitWait": {
          "type": "number",
          "minimum": 0,
          "span": 300000,
          "defaultOffset": 45000,
          "description": "Longest GitHub rate-limit wait in milliseconds (primary or secondary limit, code-search window) before a call fails with retryAfter.",
          "notes": "Waiting does not count against network.timeout; the tool call's own deadline still bounds it. The default stays under the 60 s tool-call timeout some MCP hosts apply.",
          "env": {
            "name": "OCTOCODE_MAX_RATE_LIMIT_WAIT"
          }
        },
        "allowPrivateRegistry": {
          "type": "boolean",
          "default": false,
          "description": "Allow private, loopback, or link-local artifact registries.",
          "env": {
            "name": "OCTOCODE_ALLOW_PRIVATE_REGISTRY",
            "dotenv": "home"
          },
          "notes": "Security-sensitive SSRF escape hatch; opt in only for trusted enterprise registries."
        }
      }
    },
    "lsp": {
      "title": "LSP",
      "file": true,
      "resolved": true,
      "fields": {
        "configPath": {
          "type": "path",
          "default": null,
          "description": "Optional path to a custom lsp-servers.json.",
          "env": {
            "name": "OCTOCODE_LSP_CONFIG",
            "dotenv": "home",
            "normalize": "trim"
          }
        },
        "autoInstall": {
          "type": "enum",
          "values": [
            "prompt",
            "off",
            "auto"
          ],
          "description": "Whether `octocode lsp-server install` may download a managed language server: prompt (ask), off, or auto.",
          "env": {
            "name": "OCTOCODE_LSP_AUTO_INSTALL",
            "dotenv": "home",
            "normalize": "lower"
          }
        },
        "cacheDir": {
          "type": "path",
          "default": null,
          "description": "Directory for managed language-server installs; default <octocode home>/lsp.",
          "env": {
            "name": "OCTOCODE_LSP_CACHE_DIR",
            "dotenv": "home",
            "normalize": "trim"
          }
        },
        "maxMemoryMb": {
          "type": "number",
          "minimum": 0,
          "span": 4294967295,
          "default": null,
          "displayDefault": "25% of host RAM, between 4096 and 8192",
          "description": "Resident-memory cap per language server process tree, in MiB. Unset: 25% of host RAM, between 4096 and 8192. 0 disables the cap. A server over the cap is stopped and lspSearch reports serverCrashed (not retryable).",
          "env": {
            "name": "OCTOCODE_LSP_MAX_MEMORY_MB",
            "dotenv": "home"
          }
        },
        "trustProjectConfig": {
          "type": "boolean",
          "default": false,
          "description": "Trust a project .octocode/lsp-servers.json. Security-sensitive: a trusted project config can launch server binaries.",
          "env": {
            "name": "OCTOCODE_TRUST_PROJECT_LSP_CONFIG",
            "dotenv": "home"
          }
        },
        "prewarm": {
          "type": "enum",
          "values": [
            "targeted",
            "all",
            "off"
          ],
          "description": "Language-server prewarm: targeted starts the server an offered lspSearch call names; all also warms the file a read or search names; off disables it.",
          "env": {
            "name": "OCTOCODE_LSP_PREWARM",
            "normalize": "lower"
          }
        }
      }
    },
    "output": {
      "title": "Output",
      "file": true,
      "resolved": true,
      "fields": {
        "format": {
          "type": "enum",
          "typeName": "OutputFormat",
          "values": [
            "yaml",
            "json"
          ],
          "description": "Encoding of rendered text content (the MCP text channel): yaml or json. Structured content and CLI stdout are always JSON.",
          "env": {
            "name": "OCTOCODE_OUTPUT_FORMAT",
            "normalize": "lower"
          }
        },
        "redactEmails": {
          "type": "boolean",
          "default": false,
          "description": "Mask email addresses such as GitHub commit authors.",
          "env": {
            "name": "OCTOCODE_REDACT_EMAILS",
            "dotenv": "home",
            "workspaceNarrowsTo": "true"
          }
        }
      }
    },
    "output.pagination": {
      "title": "Output pagination",
      "rustTypeName": "Pagination",
      "file": true,
      "resolved": true,
      "fields": {
        "defaultCharLength": {
          "type": "number",
          "minimum": 1000,
          "span": 49000,
          "defaultOffset": 49000,
          "description": "Automatic pagination character budget.",
          "env": {
            "name": "OCTOCODE_OUTPUT_DEFAULT_CHAR_LENGTH"
          }
        }
      }
    },
    "storage": {
      "title": "Runtime storage",
      "file": true,
      "resolved": true,
      "fields": {
        "mode": {
          "type": "enum",
          "typeName": "StorageMode",
          "enumStyle": "quotedOr",
          "values": [
            "persistent",
            "memory"
          ],
          "description": "Whether caches and runtime state may persist on disk.",
          "env": {
            "name": "OCTOCODE_STORAGE_MODE",
            "dotenv": "home",
            "normalize": "lower",
            "workspaceNarrowsTo": "memory"
          }
        },
        "stats": {
          "type": "boolean",
          "default": false,
          "description": "Write stats.json on flush; stats remain in memory either way.",
          "env": {
            "name": "OCTOCODE_ENABLE_STATS"
          }
        }
      }
    },
    "storage.cloneCache": {
      "title": "Clone cache",
      "file": true,
      "resolved": true,
      "rustTypeName": "CloneCache",
      "fields": {
        "ttl": {
          "type": "number",
          "minimum": 60000,
          "span": 2591940000,
          "defaultOffset": 86340000,
          "description": "Milliseconds a ghCloneRepo checkout stays fresh before it is re-fetched.",
          "env": {
            "name": "OCTOCODE_CACHE_TTL_MS"
          }
        },
        "maxSize": {
          "type": "number",
          "minimum": 1048576,
          "span": 1099510579200,
          "defaultOffset": 2146435072,
          "description": "Byte cap for the on-disk ghCloneRepo cache; least-recently-used checkouts are evicted above it.",
          "env": {
            "name": "OCTOCODE_MAX_CACHE_SIZE"
          }
        },
        "maxClones": {
          "type": "number",
          "minimum": 1,
          "span": 999,
          "defaultOffset": 49,
          "description": "Maximum repositories the ghCloneRepo cache keeps.",
          "env": {
            "name": "OCTOCODE_MAX_CLONES"
          }
        }
      }
    },
    "classification": {
      "title": "Classification provider",
      "file": true,
      "resolved": true,
      "fields": {
        "api": {
          "type": "string",
          "default": null,
          "credential": true,
          "description": "Classification provider API key, required for read-tool classifiers and the beta clasify tool.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_API",
            "dotenv": "all",
            "normalize": "trim"
          },
          "displayDefault": "unset",
          "notes": "Credential values are omitted from resolved configuration and diagnostics."
        },
        "apiHost": {
          "type": "url",
          "default": null,
          "credential": true,
          "description": "Optional override of the classification provider's default API root.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_API_HOST",
            "dotenv": "home",
            "normalize": "trim"
          },
          "displayDefault": "built-in provider default (https://api.typesafe.ai)",
          "notes": "Requires HTTP or HTTPS at config validation; provider policy may require HTTPS except loopback."
        },
        "model": {
          "type": "string",
          "default": null,
          "description": "Classification model for read-tool classifiers and clasify; a clasify row's model overrides it.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_MODEL",
            "dotenv": "all",
            "normalize": "trim"
          },
          "displayDefault": "built-in provider default (jev-latest)",
          "notes": "Pin an exact model (for example jev-1.13.0) for reproducible results; an alias can change behind cached answers until they expire."
        },
        "maxConcurrency": {
          "type": "number",
          "minimum": 1,
          "span": 63,
          "defaultOffset": 9,
          "description": "Process-wide maximum in-flight classification provider requests per provider endpoint.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_CONCURRENCY"
          }
        },
        "maxCandidates": {
          "type": "number",
          "minimum": 1,
          "span": 255,
          "defaultOffset": 63,
          "description": "Maximum complete evidence units assessed per context selection operation; unassessed units remain unknown and recoverable.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_MAX_CANDIDATES"
          }
        },
        "maxChars": {
          "type": "number",
          "minimum": 1024,
          "span": 1047552,
          "defaultOffset": 130048,
          "description": "Maximum total characters in serialized sanitized candidate states per context selection operation, including source metadata; excludes question instructions and request envelopes.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_MAX_CHARS"
          }
        },
        "timeoutMs": {
          "type": "number",
          "minimum": 100,
          "span": 59900,
          "defaultOffset": 9900,
          "description": "Context selection deadline in milliseconds, bounded by the enclosing request deadline.",
          "env": {
            "name": "OCTOCODE_CLASSIFICATION_TIMEOUT_MS"
          }
        }
      }
    }
  }
}
