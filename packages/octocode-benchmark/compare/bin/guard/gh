#!/usr/bin/env bash
# Read-only gh for benchmark runners. run_arm.sh puts this directory first on PATH, so a
# runner's `gh …` lands here: reads pass through to the real gh, anything that could change
# GitHub or local auth/config is refused (exit 2) and shows up as a failed call.
set -euo pipefail
REAL_GH="${REAL_GH:?run_arm.sh sets REAL_GH}"
# REAL_GH resolved after this guard went first on PATH would point back here and loop forever.
if [ "$REAL_GH" -ef "$0" ]; then echo "benchmark guard: REAL_GH points at the guard itself" >&2; exit 3; fi
deny() { echo "benchmark guard: \`gh $*\` is not allowed (read-only runner)" >&2; exit 2; }

case "${1:-}" in
  search) ;;
  repo|pr|issue|release)
    case "${2:-}" in view|list|diff|checks) ;; *) deny "$@" ;; esac ;;
  api)
    method=GET; body=0
    for ((i = 2; i <= $#; i++)); do
      a="${!i}"
      case "$a" in
        -X|--method) j=$((i + 1)); method="${!j:-}" ;;
        -X*) method="${a#-X}" ;;
        --method=*) method="${a#--method=}" ;;
        -f|-F|--field|--raw-field|--input|-f*|-F*|--field=*|--raw-field=*|--input=*) body=1 ;;
      esac
    done
    method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
    if [ "${2:-}" = graphql ]; then
      case "$*" in *mutation*) deny "$@" ;; esac
    elif [ "$method" != GET ] || { [ "$body" = 1 ] && ! printf '%s\n' "$@" | grep -qxiE -- '-X|--method|-XGET|--method=GET'; }; then
      deny "$@"
    fi ;;
  --version|version) ;;
  *) deny "$@" ;;
esac
exec "$REAL_GH" "$@"
