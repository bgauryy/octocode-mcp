#!/usr/bin/env bash
# Read-only git for the local-shell benchmark arm. run_arm.sh puts this directory first on
# PATH for that arm only: history and tree reads pass through to the real git; anything that
# could write, run a pager/external program, or change config is refused (exit 2) and shows
# up as a failed call.
set -euo pipefail
REAL_GIT="${REAL_GIT:?run_arm.sh sets REAL_GIT}"
if [ "$REAL_GIT" -ef "$0" ]; then echo "benchmark guard: REAL_GIT points at the guard itself" >&2; exit 3; fi
deny() { echo "benchmark guard: \`git $*\` is not allowed (read-only runner)" >&2; exit 2; }

args=("$@"); i=0
while [ "$i" -lt "${#args[@]}" ]; do        # global options: only -C <dir> and --no-pager
  case "${args[$i]}" in
    -C) i=$((i + 2)) ;;
    --no-pager) i=$((i + 1)) ;;
    *) break ;;
  esac
done
case "${args[$i]:-}" in
  log|show|grep|ls-files|ls-tree|blame|rev-parse|cat-file|diff|shortlog|describe|rev-list|version|--version) ;;
  *) deny "$@" ;;
esac
for a in "$@"; do
  case "$a" in
    --output|--output=*|-O|-O*|--open-files-in-pager*|--ext-diff|--textconv|--exec|--exec=*) deny "$@" ;;
  esac
done
exec "$REAL_GIT" --no-pager "$@"
