#!/usr/bin/env bash
# Read-only find for the local-shell benchmark arm: actions that delete, run programs or
# write files are refused (exit 2) and show up as a failed call.
set -euo pipefail
REAL_FIND="${REAL_FIND:?run_arm.sh sets REAL_FIND}"
if [ "$REAL_FIND" -ef "$0" ]; then echo "benchmark guard: REAL_FIND points at the guard itself" >&2; exit 3; fi
for a in "$@"; do
  case "$a" in
    -delete|-exec|-execdir|-ok|-okdir|-fprint|-fprint0|-fprintf|-fls)
      echo "benchmark guard: \`find $*\` is not allowed (read-only runner)" >&2; exit 2 ;;
  esac
done
exec "$REAL_FIND" "$@"
